# ===== مزوّد الذكاء الاصطناعي (اختر واحداً على الأقل) =====
# Claude (موصى به لأفضل جودة في البرمجة)
ANTHROPIC_API_KEY=
# النموذج ومستوى الجهد (اختياري)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high

# أو أي مزوّد متوافق مع OpenAI (Gemini / OpenRouter / OpenAI)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=
# LLM_MODEL=

# بدون أي مفتاح تعمل المنصة في "الوضع التجريبي" بموقع نموذجي ثابت.

# ===== الحماية =====
# رمز دخول اختياري لمنع استهلاك رصيدك من الغرباء قبل إضافة نظام الحسابات
BANNAA_ACCESS_CODE=

# ===== الحسابات وقاعدة البيانات (المرحلة 2) =====
# Postgres (Supabase / Neon / أي Postgres). بدونه تُحفظ البيانات في ملف .data/db.json (مناسب للتطوير أو خادم واحد)
DATABASE_URL=
# DATABASE_SSL=no-verify   # لبعض مزودي Postgres المُدارة
# سر توقيع جلسات الدخول — إلزامي في الإنتاج: openssl rand -hex 32
AUTH_SECRET=
# ALLOW_SIGNUP=false       # إغلاق التسجيل
# REQUIRE_LOGIN=true       # لا توليد بدون حساب
# DAILY_LIMIT=30           # حد الطلبات اليومي لكل مستخدم (0 = بلا حد)

# ===== النشر =====
# نطاق مستقل لخدمة المواقع المنشورة (عزل كامل + localStorage حقيقي)، مثال: https://sites.example.com
# وجّه هذا النطاق لنفس التطبيق. بدونه تُخدم المواقع من /s/<slug>/ داخل sandbox آمن.
SITES_URL=
