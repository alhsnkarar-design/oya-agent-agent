---
// Static, code-drawn picture of the editor. Swap for a real screenshot once the product exists.
const commands = [
  { text: "«دخّل العنوان من اليمين»", meta: "حركة دخول · 0.6 ث" },
  { text: "«ضيف كابشن بالمصري»", meta: "42 كلمة" },
  { text: "«شيل السكتات»", meta: "اتشال 14 سكتة" },
];
const tracks = [
  { name: "فيديو", kind: "v", clips: [[0, 46], [47, 35]] },
  { name: "نص", kind: "x", clips: [[3, 30], [50, 22]] },
  { name: "كابشن", kind: "c", clips: [[0, 18], [19, 24], [44, 20], [65, 17]] },
  { name: "صوت", kind: "a", clips: [[0, 82]] },
];
const ruler = ["0:00", "0:05", "0:10", "0:15", "0:20"];
---
<section class="wrap shot" aria-label="شكل المحرر">
  <div class="app" role="img" aria-label="واجهة محرر حركة: معاينة فيديو بعنوان عرض الجمعة، وقائمة أوامر صوتية، وخط زمني بأربع طبقات">
    <div class="bar">
      <span class="file">إعلان عرض الجمعة</span>
      <span class="saved">اتحفظ</span>
      <span class="export">تصدير</span>
    </div>
    <div class="body">
      <aside class="side">
        <h4>أوامرك</h4>
        {commands.map((c) => (
          <div class="cmd">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M5 12.5l4.5 4.5L19 7.5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <span>{c.text}<small>{c.meta}</small></span>
          </div>
        ))}
        <div class="cmd live">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><rect x="9" y="3" width="6" height="11" rx="3" stroke="currentColor" stroke-width="2" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
          <span>«خلّي الخصم بالأصفر»<small>بيتنفّذ…</small></span>
        </div>
      </aside>

      <div class="stage">
        <div class="frame">
          <span class="ratio">16:9 · 1080p</span>
          <p class="t">عرض الجمعة<em>خصم 20% على كل المنيو</em></p>
          <p class="cap">مستنيينكم <b>يوم</b> الجمعة من الساعة 1</p>
        </div>
        <span class="voice">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><rect x="9" y="3" width="6" height="11" rx="3" stroke="currentColor" stroke-width="2" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
          «خلّي الخصم بالأصفر»
        </span>
      </div>

      <div class="timeline">
        <div class="ruler">{ruler.map((r) => <span>{r}</span>)}</div>
        {tracks.map((t) => (
          <div class={`trk ${t.kind}`}>
            <span>{t.name}</span>
            <div class="lane">
              {t.clips.map(([from, width]) => <i class="clip" style={`right:${from}%;width:${width}%`} />)}
            </div>
          </div>
        ))}
        <span class="playhead" aria-hidden="true"></span>
      </div>
    </div>
  </div>
</section>

<style>
  .shot { padding-bottom: clamp(72px, 10vw, 130px); }
  .app {
    background: var(--app); color: var(--app-ink); border-radius: 14px; overflow: hidden;
    box-shadow: 0 1px 0 rgba(255, 255, 255, .04) inset, 0 30px 60px -30px rgba(0, 0, 0, .35), 0 0 0 1px rgba(0, 0, 0, .08);
  }
  .bar { display: flex; align-items: center; gap: 14px; height: 46px; padding-inline: 16px; border-bottom: 1px solid #000; background: var(--app-2); font-size: .82rem; }
  .file { font-weight: 500; }
  .saved { color: var(--app-ink-2); }
  .export { margin-inline-start: auto; background: var(--accent); color: var(--accent-ink); font-weight: 600; padding: 6px 12px; border-radius: 6px; }
  .body { display: grid; grid-template-columns: 240px minmax(0, 1fr); }
  .side { border-inline-end: 1px solid #000; background: var(--app-2); padding: 14px; display: grid; align-content: start; gap: 10px; font-size: .8rem; }
  h4 { margin: 0 0 4px; font: 600 .72rem/1 var(--f-body); color: var(--app-ink-2); }
  .cmd { display: grid; grid-template-columns: 16px 1fr; gap: 8px; align-items: start; padding: 8px 10px; border-radius: 8px; background: var(--app-3); }
  .cmd svg { margin-top: 3px; color: #5cc48b; }
  .cmd.live { box-shadow: inset 0 0 0 1px var(--accent); }
  .cmd.live svg { color: var(--accent); }
  .cmd small { display: block; color: var(--app-ink-2); font-size: .72rem; }
  .stage { padding: 22px; display: grid; place-items: center; background: #0f1013; }
  .frame {
    width: min(100%, 560px); aspect-ratio: 16 / 9; border-radius: 6px; position: relative; overflow: hidden;
    background: linear-gradient(180deg, transparent 45%, rgba(0, 0, 0, .55)), linear-gradient(135deg, #3b2a1e, #7a4b26 55%, #c9822f);
  }
  .t { position: absolute; top: 16%; right: 7%; font: 800 clamp(1.3rem, 3.4vw, 2.4rem)/1.15 var(--f-display); color: #fff; }
  .t em { font-style: normal; color: var(--accent); display: block; font-size: .55em; font-weight: 600; margin-top: 6px; }
  .cap { position: absolute; bottom: 9%; left: 50%; transform: translateX(-50%); white-space: nowrap; font: 600 clamp(.7rem, 1.6vw, .95rem)/1.4 var(--f-display); color: #fff; }
  .cap b { background: var(--accent); color: var(--accent-ink); padding: 0 .25em; border-radius: 3px; font-weight: 600; }
  .ratio { position: absolute; top: 8px; left: 8px; font-size: .65rem; color: rgba(255, 255, 255, .7); direction: ltr; }
  .voice { margin-top: 14px; display: inline-flex; align-items: center; gap: 10px; font-size: .82rem; background: var(--app-3); padding: 7px 14px; border-radius: 999px; }
  .voice svg { color: var(--accent); }
  .timeline { grid-column: 1 / -1; border-top: 1px solid #000; background: var(--app-2); padding: 10px 16px 14px; font-size: .72rem; color: var(--app-ink-2); position: relative; }
  .ruler { display: flex; justify-content: space-between; padding-inline-start: 72px; margin-bottom: 8px; }
  .trk { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 8px; align-items: center; height: 26px; margin-top: 5px; }
  .lane { position: relative; height: 100%; background: var(--app-3); border-radius: 4px; }
  .clip { position: absolute; top: 3px; bottom: 3px; border-radius: 3px; }
  .v .clip { background: #3e6fd8; }
  .x .clip { background: #c3529a; }
  .c .clip { background: #c99024; }
  .a .clip { background: #2e9e78 repeating-linear-gradient(to left, rgba(0, 0, 0, .25) 0 1px, transparent 1px 4px); }
  .playhead { position: absolute; top: 30px; bottom: 10px; right: calc(16px + 72px + 38%); width: 1px; background: var(--accent); }
  .playhead::before { content: ""; position: absolute; top: -4px; left: -4px; width: 9px; height: 9px; background: var(--accent); border-radius: 2px; }
  @media (max-width: 760px) {
    .body { grid-template-columns: 1fr; }
    .side { display: none; }
    .stage { padding: 14px; }
    .trk { grid-template-columns: 44px minmax(0, 1fr); }
    .ruler { padding-inline-start: 52px; }
    .playhead { right: calc(16px + 52px + 38%); }
  }
</style>
