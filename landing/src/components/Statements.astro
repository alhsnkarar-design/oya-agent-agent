---
// One feature per section: a large sentence, its quieter second half, and one line of detail.
const items = [
  { a: "ارفع الخام.", b: "والمونتاج يخلص لوحده.", p: "السكتات والتكرار والغلطات بتتشال، واللقطات بتترتّب، والانتقالات بتتحط." },
  { a: "اكتب الفكرة.", b: "يطلع لك موشن جرافيكس.", p: "«إعلان لعرض الجمعة، ألوان دافية» يبقى عناوين ونصوص وأشكال متحركة جاهزة." },
  { a: "قولها بصوتك.", b: "وهو بيعدّل قدامك.", p: "«كبّر العنوان»، «احذف المشهد التاني». في نفس اللحظة، من غير ما تلمس الخط الزمني." },
  { a: "المؤثرات على الإيقاع.", b: "من غير ولا كيفريم.", p: "الزووم والانتقالات وظهور النصوص بتتظبط على إيقاع الكلام." },
  { a: "كابشن بلهجتك.", b: "كلمة بكلمة.", p: "مصري، خليجي، شامي، فصحى. على توقيت الكلام وبخطوط عربية." },
  { a: "مقاس لكل منصة.", b: "بضغطة واحدة.", p: "ريلز وتيك توك ويوتيوب وإنستجرام من نفس المشروع." },
];
---
{items.map((it, i) => (
  <section class:list={["band", { alt: i % 2 === 0 }]} aria-label={it.a}>
    <div class="wrap statement">
      <h2>{it.a}<span>{it.b}</span></h2>
      <p>{it.p}</p>
    </div>
  </section>
))}

<style>
  .band { padding-block: clamp(96px, 14vw, 180px); }
  .band.alt { background: var(--tint); }
</style>
