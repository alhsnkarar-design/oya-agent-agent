---
const faqs = [
  { q: "هل حركة بيولّد فيديو بالذكاء الاصطناعي؟", a: "لأ. حركة بيعمل المونتاج والموشن جرافيكس والمؤثرات على الفيديو بتاعك، أو بيعمل موشن جرافيكس من وصفك (نصوص وعناوين وأشكال متحركة)." },
  { q: "محتاج خبرة في المونتاج؟", a: "خالص. لو تقدر تقول اللي عايزه بالكلام، تقدر تطلّع الفيديو." },
  { q: "بيفهم لهجتي؟", a: "بنبدأ بالمصري والخليجي والشامي والفصحى، في الأوامر وفي الكابشن." },
  { q: "الحجز بيكلّفني حاجة؟", a: "لأ. الحجز بالإيميل بس، ومن غير بطاقة دفع. أول 100 هياخدوا خصم 50% لمدة 3 شهور لما الاشتراك يبدأ." },
];
---
<section class="faq" id="faq" aria-labelledby="t-faq">
  <div class="wrap">
    <h2 id="t-faq">أسئلة</h2>
    <div class="list">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { padding-block: clamp(64px, 9vw, 112px); }
  .wrap { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 24px 64px; }
  @media (max-width: 760px) { .wrap { grid-template-columns: 1fr; } }
  h2 { font: 800 clamp(1.8rem, 3.4vw, 2.6rem)/1.25 var(--f-display); }
  .list { border-top: 2px solid var(--ink); }
  details { border-bottom: 1px solid var(--line); }
  summary {
    cursor: pointer; list-style: none; padding-block: 20px; display: flex; justify-content: space-between; gap: 20px;
    font: 700 1.12rem/1.5 var(--f-display);
  }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; font: 400 1.6rem/1 var(--f-body); color: var(--ink-3); }
  details[open] summary::after { content: "−"; }
  details p { color: var(--ink-2); padding-bottom: 20px; max-width: 60ch; }
</style>
