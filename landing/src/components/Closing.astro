---
import BookForm from "./BookForm.astro";
---
<section class="section closing" aria-labelledby="t-close">
  <div class="wrap panel">
    <div>
      <h2 class="h2" id="t-close">احجز مكانك <em>قبل ما نفتح.</em></h2>
      <p class="lead">أول 100 يحجزوا ليهم خصم 50% لمدة 3 شهور.</p>
    </div>
    <BookForm id="end" size="md" />
  </div>
</section>

<style>
  .panel {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 32px 56px; align-items: center;
    

  }
  @media (max-width: 860px) { .panel { grid-template-columns: 1fr; } }
</style>
