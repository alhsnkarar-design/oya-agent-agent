---
import BookForm from "./BookForm.astro";
---
<section class="closing" aria-labelledby="t-close">
  <div class="wrap">
    <h2 id="t-close">المونتير بتاعك<br />جاهز يستلم.</h2>
    <div class="side">
      <p>سيب إيميلك، وأول ما النسخة الأولى تفتح هتكون من أول الناس اللي تجرّبها.</p>
      <BookForm id="close" tone="dark" />
    </div>
  </div>
</section>

<style>
  .closing { background: #0c0c0d; color: #f2f2f3; }
  .wrap {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 32px 72px; align-items: end;
    padding-block: clamp(64px, 9vw, 120px);
  }
  @media (max-width: 860px) { .wrap { grid-template-columns: 1fr; align-items: start; } }
  h2 { font: 800 clamp(2.2rem, 5vw, 4rem)/1.2 var(--f-display); }
  .side { display: grid; gap: 18px; min-width: 0; }
  .side p { color: #a6a8af; font-size: 1.05rem; max-width: 40ch; }
</style>
