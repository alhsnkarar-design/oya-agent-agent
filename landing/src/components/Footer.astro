---
const year = new Date().getFullYear();
---
<footer>
  <div class="wrap row">
    <a class="mark" href="#top">Zifidit<span>.</span></a>
    <a class="ig" href="https://instagram.com/zifidit" target="_blank" rel="noopener">
      <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r=".6" /></svg>
      تابع بنبنيه إزاي على @zifidit
    </a>
    <span class="c">© {year} Zifidit</span>
  </div>
</footer>

<style>
  footer { border-top: 1px solid var(--line); margin-top: clamp(40px, 6vw, 80px); }
  .row { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; padding-block: 28px; font-size: .88rem; color: var(--ink-3); }
  .ig { display: inline-flex; align-items: center; gap: 8px; text-decoration: none; color: var(--ink-2); }
  .ig:hover { color: var(--ink); }
  .c { direction: ltr; }
</style>
