---
// The real sequence of using the site, so the numbers carry information.
const steps = [
  { t: "ارمي الخام", p: "ارفع الفيديو زي ما صوّرته، أو اكتب فكرة الموشن في سطر." },
  { t: "قول أو اكتب", p: "«شيل السكتات»، «كبّر العنوان»، «خليه دهبي». وهو بيعدّل قدامك." },
  { t: "انشر", p: "الكابشن بلهجتك والمقاس لكل منصة جاهزين. نزّل الفيديو وانشره." },
];
---
<section class="section" id="how" aria-labelledby="t-how">
  <div class="wrap">
    <div class="head">
      <h2 class="h2" id="t-how">من الخام للنشر في <em>3 خطوات.</em></h2>
    </div>
    <ol class="steps">
      {steps.map((s, i) => (
        <li>
          <span class="n">{i + 1}</span>
          <h3>{s.t}</h3>
          <p>{s.p}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; border-block: 1px solid var(--line); }
  li { display: grid; gap: 10px; align-content: start; padding: clamp(24px, 3vw, 36px); padding-inline-start: 0; }
  li + li { border-inline-start: 1px solid var(--line); padding-inline-start: clamp(24px, 3vw, 36px); }
  .n { font: 300 clamp(3rem, 6vw, 4.6rem)/1 var(--f-display); color: transparent; -webkit-text-stroke: 1.5px var(--peri); }
  h3 { font: 700 1.35rem/1.4 var(--f-display); margin-top: 8px; }
  p { color: var(--ink-2); max-width: 34ch; }
  @media (max-width: 820px) {
    .steps { grid-template-columns: 1fr; }
    li, li + li { padding-inline: 0; border-inline-start: 0; }
    li + li { border-top: 1px solid var(--line); }
  }
</style>
