---
import BookForm from "./BookForm.astro";
---
<section class="hero" id="book" aria-labelledby="t-hero">
  <div class="glow" aria-hidden="true"></div>
  <div class="wrap grid">
    <h1 id="t-hero">المونتاج والموشن جرافيكس<span>بكلمة منك.</span></h1>
    <div class="copy">
      <p class="lede">ارمي الفيديو الخام أو اكتب فكرتك في سطر. Zifidit يعمل المونتاج والموشن والكابشن بلهجتك، وتعدّل عليه بصوتك.</p>
      <p class="note">موقع عربي من المتصفح · لسه بنبنيه، والحجز مفتوح دلوقتي</p>
    </div>
    <div class="slot">
      <BookForm id="top" />
    </div>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; padding-block: clamp(56px, 9vw, 120px) clamp(72px, 10vw, 136px); border-bottom: 1px solid var(--line); }
  /* the light of a screen in a dark hall, behind the ticket */
  .glow {
    position: absolute; inset-block: -30% -10%; inset-inline-end: -20%; width: 75%; pointer-events: none;
    background:
      radial-gradient(closest-side at 60% 45%, rgba(142, 162, 255, .28), transparent 70%),
      radial-gradient(closest-side at 40% 70%, rgba(255, 181, 71, .16), transparent 70%);
    filter: blur(10px);
  }
  .grid { position: relative; display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(28px, 4vw, 48px) clamp(40px, 6vw, 88px); align-items: center; }
  h1 { grid-column: 1 / -1; }
  .copy { display: grid; gap: 18px; align-self: start; }
  h1 { font: 800 clamp(2.4rem, 6.4vw, 5.6rem)/1.15 var(--f-display); letter-spacing: -.02em; text-wrap: balance; }
  h1 span { display: block; color: var(--amber); }
  .lede { font-size: clamp(1.05rem, 1.6vw, 1.22rem); color: var(--ink-2); max-width: 44ch; }
  .note { font-size: .9rem; color: var(--ink-3); }
  .slot { display: flex; justify-content: flex-end; }
  @media (max-width: 920px) {
    .grid { grid-template-columns: 1fr; }
    .note { display: none; }
    h1 { font-size: clamp(2.2rem, 10vw, 3rem); }
    .glow { inset-inline-end: -40%; width: 140%; inset-block: 20% -10%; }
  }
</style>
