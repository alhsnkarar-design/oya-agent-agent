---
// Five features, one plain row each.
const items = [
  { tag: "مونتاج تلقائي", h: "ارمي الخام، والمونتاج يخلص لوحده.", p: "السكتات والتكرار والغلطات بتتشال، واللقطات بتترتّب، والزووم والانتقالات بتمشي على إيقاع الكلام." },
  { tag: "موشن من وصف", h: "اكتب فكرتك في سطر، يطلع لك موشن جرافيكس.", p: "عناوين ونصوص وأشكال متحركة جاهزة بالعربي، من غير ولا كيفريم." },
  { tag: "تعديل بالصوت", h: "قولها، وهو يعدّل قدامك.", p: "«كبّر العنوان»، «خليه دهبي». في نفس اللحظة، من غير ما تلمس الخط الزمني." },
  { tag: "كابشن بلهجتك", h: "كابشن بلهجتك، كلمة كلمة.", p: "مصري، خليجي، شامي، فصحى. على توقيت الكلام وبخطوط عربية." },
  { tag: "مقاس لكل منصة", h: "نفس الفيديو لكل منصة، بدوسة.", p: "ريلز وتيك توك ويوتيوب وإنستجرام من نفس المشروع." },
];
---
<section class="section" id="features" aria-labelledby="t-feat">
  <div class="wrap">
    <h2 class="h2" id="t-feat">كل اللي بياخد منك ساعات… <em>بكلمة.</em></h2>
    <p class="lead">موقع واحد، من المتصفح، من غير ما تنزّل برنامج.</p>
    <ol class="tracks">
      {items.map((it) => (
        <li class="row">
          <span class="tag">{it.tag}</span>
          <div class="txt">
            <h3>{it.h}</h3>
            <p>{it.p}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .tracks { list-style: none; padding: 0; margin: clamp(40px, 6vw, 64px) 0 0; border-top: 1px solid var(--line); }
  .row { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 8px 40px; align-items: baseline; padding-block: clamp(26px, 3.4vw, 38px); border-bottom: 1px solid var(--line); }
  .tag { font: 600 .95rem/1.6 var(--f-body); color: var(--ink-3); }
  h3 { font: 800 clamp(1.25rem, 2.3vw, 1.6rem)/1.45 var(--f-display); text-wrap: balance; }
  .txt p { color: var(--ink-2); margin-top: 6px; max-width: 56ch; }
  @media (max-width: 760px) { .row { grid-template-columns: 1fr; } }
</style>
