---
// Five features as tracks on a timeline: a coloured clip names the feature, a sentence says what it does,
// and the right column shows the actual words you'd type or say. Colours match the reels.
const items = [
  { tag: "مونتاج تلقائي", c: "var(--teal)", h: "ارمي الخام، والمونتاج يخلص لوحده.", p: "السكتات والتكرار والغلطات بتتشال، واللقطات بتترتّب، والزووم والانتقالات بتمشي على إيقاع الكلام.", ex: ["«شيل السكتات»"] },
  { tag: "موشن من وصف", c: "var(--azure)", h: "اكتب فكرتك في سطر، يطلع لك موشن جرافيكس.", p: "عناوين ونصوص وأشكال متحركة جاهزة بالعربي، من غير ولا كيفريم.", ex: ["«إعلان لعرض الجمعة، ألوان دافية»"] },
  { tag: "تعديل بالصوت", c: "var(--coral)", h: "قولها، وهو يعدّل قدامك.", p: "في نفس اللحظة، من غير ما تلمس الخط الزمني.", ex: ["«كبّر العنوان»", "«خليه دهبي»"] },
  { tag: "كابشن بلهجتك", c: "var(--accent)", h: "كابشن بلهجتك، كلمة كلمة.", p: "على توقيت الكلام وبخطوط عربية.", ex: ["مصري", "خليجي", "شامي", "فصحى"] },
  { tag: "مقاس لكل منصة", c: "var(--rose)", h: "نفس الفيديو لكل منصة، بدوسة.", p: "ريلز وتيك توك ويوتيوب وإنستجرام من نفس المشروع.", ex: ["9:16", "1:1", "16:9"] },
];
---
<section class="section" id="features" aria-labelledby="t-feat">
  <div class="wrap">
    <h2 class="h2" id="t-feat">كل اللي بياخد منك ساعات… <em>بكلمة.</em></h2>
    <p class="lead">موقع واحد، من المتصفح، من غير ما تنزّل برنامج.</p>
    <ol class="tracks">
      {items.map((it) => (
        <li class="row" style={`--c:${it.c}`}>
          <span class="tag">{it.tag}</span>
          <div class="txt">
            <h3>{it.h}</h3>
            <p>{it.p}</p>
          </div>
          <div class="ex">{it.ex.map((e) => <span dir="auto">{e}</span>)}</div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .tracks { list-style: none; padding: 0; margin: clamp(40px, 6vw, 64px) 0 0; border-top: 1px solid var(--line); }
  .row {
    display: grid; grid-template-columns: 190px minmax(0, 1fr) minmax(0, .8fr); gap: 20px 40px; align-items: center;
    padding-block: clamp(26px, 3.4vw, 40px); border-bottom: 1px solid var(--line);
  }
  .tag {
    justify-self: start; display: inline-flex; align-items: center; height: 34px; padding-inline: 14px; border-radius: 9px;
    background: var(--c); color: var(--accent-ink); font: 700 .9rem/1 var(--f-display);
    box-shadow: 0 8px 24px -14px var(--c);
  }
  h3 { font: 800 clamp(1.25rem, 2.3vw, 1.65rem)/1.4 var(--f-display); text-wrap: balance; }
  .txt p { color: var(--ink-2); margin-top: 6px; max-width: 48ch; }
  .ex { display: flex; flex-wrap: wrap; gap: 8px; justify-content: flex-end; }
  .ex span {
    font: 600 .92rem/1 var(--f-body); color: var(--ink); padding: 10px 14px; border-radius: 10px;
    background: var(--surface); border: 1px solid var(--line-2); white-space: nowrap;
  }
  .ex span:first-child { border-color: color-mix(in srgb, var(--c) 55%, transparent); }
  @media (max-width: 860px) {
    .row { grid-template-columns: 1fr; gap: 14px; }
    .ex { justify-content: flex-start; }
  }
</style>
