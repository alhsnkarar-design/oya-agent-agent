---
// Each feature names what it does and how you trigger it.
const features = [
  { title: "مونتاج تلقائي", text: "ارفع الفيديو الخام، يقصّ السكتات والتكرار والغلطات، ويرتّب اللقطات ويضيف الانتقالات.", how: "تلقائي" },
  { title: "موشن جرافيكس من وصف", text: "اكتب «إعلان لعرض الجمعة، ألوان دافية»، يطلع لك عناوين ونصوص وأشكال متحركة جاهزة.", how: "بالكتابة" },
  { title: "تعديل بالصوت المباشر", text: "«كبّر العنوان»، «احذف المشهد التاني»، «خلّي الانتقال أسرع». بتتكلم وهو بيعدّل في نفس اللحظة.", how: "بالصوت" },
  { title: "مؤثرات على الإيقاع", text: "زووم وانتقالات ومؤثرات بتتظبط على إيقاع الكلام، من غير ما تحرّك ولا كيفريم.", how: "تلقائي" },
  { title: "كابشن عربي متحرك", text: "كلمة بكلمة على توقيت الكلام، بالمصري والخليجي والشامي والفصحى، وبخطوط عربية.", how: "تلقائي" },
  { title: "مقاس لكل منصة", text: "ريلز وتيك توك ويوتيوب وإنستجرام من نفس المشروع، والعناصر بتتظبط لوحدها.", how: "بضغطة" },
];
---
<section class="features" id="features" aria-labelledby="t-feat">
  <div class="wrap">
    <div class="head">
      <h2 id="t-feat">حركة بيعمل إيه؟</h2>
      <p>كل اللي بياخد من المونتير ساعات، بيخلص في دقايق.</p>
    </div>
    <ol>
      {features.map((f) => (
        <li>
          <h3>{f.title}</h3>
          <p>{f.text}</p>
          <span class="how">{f.how}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .features { background: var(--tint); padding-block: clamp(64px, 9vw, 120px); }
  .head { display: flex; justify-content: space-between; align-items: end; gap: 16px 40px; flex-wrap: wrap; margin-bottom: clamp(28px, 4vw, 44px); }
  h2 { font: 800 clamp(2rem, 4vw, 3.2rem)/1.2 var(--f-display); }
  .head p { color: var(--ink-2); font-size: 1.05rem; max-width: 36ch; }
  ol { list-style: none; padding: 0; margin: 0; border-top: 2px solid var(--ink); }
  li {
    display: grid; grid-template-columns: minmax(0, 15rem) minmax(0, 1fr) auto;
    gap: 8px 28px; align-items: baseline; padding-block: 22px; border-bottom: 1px solid var(--line);
  }
  h3 { font: 800 1.25rem/1.4 var(--f-display); }
  li p { color: var(--ink-2); max-width: 58ch; }
  .how {
    font: 700 .8rem/1 var(--f-body); padding: 8px 12px; border-radius: 8px;
    background: var(--page); border: 1px solid var(--line); white-space: nowrap; justify-self: start;
  }
  @media (max-width: 860px) {
    li { grid-template-columns: minmax(0, 1fr) auto; }
    li p { grid-column: 1 / -1; }
  }
</style>
