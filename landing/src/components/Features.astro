---
const icons = {
  mic: `<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/>`,
  captions: `<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M7 14h4M13 14h4M7 10.5h7"/>`,
  cut: `<circle cx="6" cy="7" r="2.5"/><circle cx="6" cy="17" r="2.5"/><path d="M8 8.5L20 16M8 15.5L20 8"/>`,
  idea: `<path d="M4 20l9-9M14 4l1 2.5 2.5 1-2.5 1L14 11l-1-2.5-2.5-1 2.5-1z"/>`,
  voice: `<path d="M4 10v4M8 7v10M12 4v16M16 8v8M20 11v2"/>`,
  formats: `<rect x="2.5" y="7" width="12" height="9" rx="1.5"/><rect x="16.5" y="4" width="5" height="16" rx="1.5"/>`,
};
const features = [
  { icon: icons.mic, title: "عدّل بصوتك", text: "«كبّر العنوان»، «احذف المشهد التاني». بتقولها والتعديل بيحصل قدامك." },
  { icon: icons.captions, title: "كابشن بلهجتك", text: "كلمة بكلمة على توقيت الكلام، بالمصري والخليجي والشامي والفصحى." },
  { icon: icons.cut, title: "مونتاج تلقائي", text: "السكتات والتكرار والغلطات بتتشال من الفيديو الخام لوحدها." },
  { icon: icons.idea, title: "من فكرة لفيديو", text: "اكتب الفكرة في سطر، وهيطلع لك المشاهد والنصوص والحركة." },
  { icon: icons.voice, title: "تعليق صوتي ودبلجة", text: "صوت عربي طبيعي بلهجتك، ودبلجة الفيديو لأي لغة." },
  { icon: icons.formats, title: "مقاس لكل منصة", text: "يوتيوب وريلز وتيك توك وإنستجرام من نفس الفيديو." },
];
---
<section class="wrap features" id="features" aria-labelledby="t-feat">
  <h2 id="t-feat">كل اللي محتاجه عشان تطلّع فيديو، في مكان واحد.</h2>
  <ul>
    {features.map((f) => (
      <li>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={f.icon} />
        <h3>{f.title}</h3>
        <p>{f.text}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .features { border-top: 1px solid var(--line); padding-block: clamp(64px, 9vw, 120px); display: grid; gap: clamp(36px, 5vw, 56px); }
  h2 { font: 800 clamp(1.8rem, 3.4vw, 2.6rem)/1.3 var(--f-display); max-width: 20ch; text-wrap: balance; }
  ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 44px 40px; list-style: none; padding: 0; }
  @media (max-width: 900px) { ul { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { ul { grid-template-columns: 1fr; gap: 32px; } }
  li { display: grid; gap: 8px; align-content: start; }
  svg { margin-bottom: 6px; }
  h3 { font: 700 1.08rem/1.4 var(--f-display); }
  p { color: var(--ink-2); font-size: .97rem; max-width: 34ch; }
</style>
