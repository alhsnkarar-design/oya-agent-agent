---
// The booking form, designed as an admission ticket to the first version.
// Email only. Used in the hero and at the end of the page; the script wires every instance.
interface Props { id: string; }
const { id } = Astro.props;
---
<div class="ticket" data-book>
  <aside class="stub" aria-hidden="true">
    <span class="brand">Zifidit<b>.</b></span>
    <span class="kind">تذكرة النسخة الأولى</span>
    <span class="perk"><strong>أول 100</strong>خصم 50% لمدة 3 شهور</span>
  </aside>

  <div class="main">
    <p class="title">احجز مكانك قبل ما نفتح</p>
    <form novalidate>
      <label class="sr" for={`${id}-email`}>الإيميل</label>
      <div class="field">
        <input id={`${id}-email`} name="email" type="email" maxlength="160" autocomplete="email" inputmode="email" required placeholder="name@example.com" dir="ltr" />
        <button type="submit">
          <span class="lbl">احجز مكاني</span>
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>
        </button>
      </div>
      <div class="sr" aria-hidden="true">
        <label for={`${id}-website`}>سيب الخانة دي فاضية</label>
        <input id={`${id}-website`} name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
    </form>
    <p class="msg" role="status" aria-live="polite"></p>
    <ul class="assure">
      <li>إيميلك بس</li>
      <li>من غير بطاقة دفع</li>
      <li>رسالة واحدة لما نفتح</li>
    </ul>

    <div class="done" hidden>
      <p class="d0">اتحجز</p>
      <p class="d1">مكانك محفوظ<span class="pos" hidden></span>.</p>
      <p class="d2">هنبعتلك أول ما النسخة الأولى تجهز. ولحد ما نفتح، تابع بنبنيه إزاي على <a href="https://instagram.com/zifidit" target="_blank" rel="noopener">@zifidit</a>.</p>
    </div>
  </div>
</div>

<style>
  .ticket {
    --notch: 14px;
    position: relative; display: grid; grid-template-columns: minmax(0, 1fr) 150px; width: 100%; max-width: 640px;
    border-radius: 22px; background: var(--surface); border: 1px solid var(--line-2);
    box-shadow: 0 30px 70px -30px rgba(0, 0, 0, .85), 0 1px 0 rgba(255, 255, 255, .05) inset;
    /* the two notches where the stub tears off */
    -webkit-mask: radial-gradient(circle var(--notch) at 150px 0, #0000 98%, #000) top / 100% 51% no-repeat,
                  radial-gradient(circle var(--notch) at 150px 100%, #0000 98%, #000) bottom / 100% 51% no-repeat;
            mask: radial-gradient(circle var(--notch) at 150px 0, #0000 98%, #000) top / 100% 51% no-repeat,
                  radial-gradient(circle var(--notch) at 150px 100%, #0000 98%, #000) bottom / 100% 51% no-repeat;
  }
  .stub {
    grid-column: 2; grid-row: 1; display: flex; flex-direction: column; justify-content: space-between; gap: 18px;
    padding: 24px 20px; border-inline-start: 2px dashed var(--line-2);
    background: linear-gradient(160deg, rgba(255, 181, 71, .16), rgba(142, 162, 255, .08) 70%);
    border-start-end-radius: 21px; border-end-end-radius: 21px;
  }
  .brand { font: 800 1.15rem/1 var(--f-display); direction: ltr; text-align: end; }
  .brand b { color: var(--amber); }
  .kind { font: 600 .82rem/1.5 var(--f-body); color: var(--ink-2); }
  .perk { display: grid; gap: 2px; font-size: .82rem; color: var(--ink-2); line-height: 1.5; }
  .perk strong { font: 800 1.35rem/1.2 var(--f-display); color: var(--amber); }

  .main { grid-column: 1; grid-row: 1; padding: 26px 26px 22px; display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; min-width: 0; }
  .title { font: 700 1.2rem/1.4 var(--f-display); }
  .field {
    display: flex; gap: 6px; padding: 6px; border-radius: 15px; background: var(--bg); border: 1px solid var(--line-2);
    transition: border-color .2s, box-shadow .2s;
  }
  .field:focus-within { border-color: var(--amber); box-shadow: 0 0 0 4px rgba(255, 181, 71, .14); }
  input[type="email"] {
    flex: 1; min-width: 0; width: 100%; height: 50px; padding-inline: 14px; border: 0; background: transparent; outline: none;
    font: 400 1.02rem/1 var(--f-body); color: var(--ink); text-align: right;
  }
  input::placeholder { color: var(--ink-3); }
  button {
    display: inline-flex; align-items: center; gap: 10px; height: 50px; padding-inline: 20px 16px; border: 0; border-radius: 11px; cursor: pointer;
    font: 700 1rem/1 var(--f-body); white-space: nowrap; background: var(--amber); color: var(--amber-ink);
    box-shadow: 0 10px 24px -12px rgba(255, 181, 71, .8); transition: transform .15s, filter .15s;
  }
  button:hover { filter: brightness(1.06); }
  button:active { transform: translateY(1px); }
  button:disabled { filter: saturate(.4); cursor: progress; }
  .assure { display: flex; flex-wrap: wrap; gap: 4px 0; font-size: .84rem; color: var(--ink-3); }
  .assure li:not(:last-child)::after { content: "·"; margin-inline: 10px; color: var(--line-2); }
  .msg { font-size: .9rem; }
  .msg:empty { display: none; }
  .msg.err { color: var(--danger); }

  .done { display: grid; gap: 6px; }
  .d0 { justify-self: start; font: 700 .78rem/1 var(--f-body); color: var(--amber-ink); background: var(--amber); padding: 7px 12px; border-radius: 99px; }
  .d1 { font: 800 1.5rem/1.4 var(--f-display); }
  .pos { color: var(--amber); }
  .d2 { color: var(--ink-2); font-size: .95rem; max-width: 46ch; }
  .d2 a { color: var(--ink); }
  .ticket:has(.done:not([hidden])) :is(.title, .assure) { display: none; }

  @media (max-width: 560px) {
    .ticket {
      grid-template-columns: 1fr;
      -webkit-mask: radial-gradient(circle var(--notch) at 0 92px, #0000 98%, #000) left / 51% 100% no-repeat,
                    radial-gradient(circle var(--notch) at 100% 92px, #0000 98%, #000) right / 51% 100% no-repeat;
              mask: radial-gradient(circle var(--notch) at 0 92px, #0000 98%, #000) left / 51% 100% no-repeat,
                    radial-gradient(circle var(--notch) at 100% 92px, #0000 98%, #000) right / 51% 100% no-repeat;
    }
    .stub {
      grid-column: 1; grid-row: 1; height: 92px; flex-direction: row; align-items: center; padding: 16px 20px;
      border-inline-start: 0; border-bottom: 2px dashed var(--line-2); border-radius: 21px 21px 0 0;
    }
    .kind { display: none; }
    .perk { text-align: end; }
    .perk strong { font-size: 1.1rem; }
    .main { grid-row: 2; padding: 20px 18px 18px; }
    .field { flex-wrap: wrap; }
    input[type="email"] { flex-basis: 100%; }
    button { flex: 1; justify-content: center; }
  }
</style>

<script>
  const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  const params = new URLSearchParams(location.search);
  const utm = {
    source: params.get("utm_source") ?? "",
    medium: params.get("utm_medium") ?? "",
    campaign: params.get("utm_campaign") ?? "",
  };

  for (const box of document.querySelectorAll<HTMLElement>("[data-book]")) {
    const form = box.querySelector("form")!;
    const input = form.querySelector<HTMLInputElement>('input[type="email"]')!;
    const button = form.querySelector("button")!;
    const label = button.querySelector<HTMLElement>(".lbl")!;
    const msg = box.querySelector<HTMLElement>(".msg")!;
    const done = box.querySelector<HTMLElement>(".done")!;
    const pos = box.querySelector<HTMLElement>(".pos")!;
    const fail = (text: string) => { msg.className = "msg err"; msg.textContent = text; };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const email = String(data.get("email") ?? "").trim();
      if (!emailRe.test(email)) { fail("اكتب إيميل صحيح، زي name@example.com"); input.focus(); return; }
      button.disabled = true; label.textContent = "بنحجزلك…"; msg.className = "msg"; msg.textContent = "";
      try {
        const res = await fetch("/api/waitlist", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email, website: String(data.get("website") ?? ""), utm, referrer: document.referrer.slice(0, 300) }),
        });
        if (res.ok) {
          const body = await res.json().catch(() => ({}));
          // The real queue number, when the server knows it.
          if (Number.isInteger(body.position) && body.position > 0) { pos.textContent = `، ورقمك ${body.position} في الطابور`; pos.hidden = false; }
          form.hidden = true; done.hidden = false; return;
        }
        const body = await res.json().catch(() => ({}));
        fail(body.error === "invalid_email" ? "اكتب إيميل صحيح، زي name@example.com" : "الحجز ما تمّش. جرّب تاني بعد دقيقة.");
      } catch {
        fail("مفيش اتصال. اتأكد من النت وجرّب تاني.");
      } finally {
        button.disabled = false; label.textContent = "احجز مكاني";
      }
    });
  }
</script>
