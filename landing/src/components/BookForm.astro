---
// Email-only booking form. Used in the hero and at the end of the page;
// the script wires every instance.
interface Props { id: string; size?: "lg" | "md"; }
const { id, size = "lg" } = Astro.props;
---
<div class:list={["book", size]} data-book>
  <form novalidate>
    <label class="sr" for={`${id}-email`}>الإيميل</label>
    <div class="bar">
      <svg class="ico mail" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5" /><path d="m4 7 8 6 8-6" /></svg>
      <input id={`${id}-email`} name="email" type="email" maxlength="160" autocomplete="email" inputmode="email" required placeholder="اكتب إيميلك" dir="auto" />
      <button type="submit">
        <span class="lbl">احجز مكاني</span>
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>
      </button>
    </div>
    <div class="sr" aria-hidden="true">
      <label for={`${id}-website`}>سيب الخانة دي فاضية</label>
      <input id={`${id}-website`} name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
  </form>
  <ul class="assure">
    <li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4.5 4.5L19 7" /></svg>إيميلك بس</li>
    <li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4.5 4.5L19 7" /></svg>من غير بطاقة دفع</li>
    <li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4.5 4.5L19 7" /></svg>رسالة واحدة لما نفتح</li>
  </ul>
  <p class="msg" role="status" aria-live="polite"></p>
  <div class="done" hidden>
    <span class="tick"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4.5 4.5L19 7" /></svg></span>
    <div>
      <p class="d1">مكانك اتحجز.</p>
      <p class="d2">هنبعتلك أول ما النسخة الأولى تجهز. ولحد ما نفتح، تابع بنبنيه إزاي على <a href="https://instagram.com/zifidit" target="_blank" rel="noopener">@zifidit</a>.</p>
    </div>
  </div>
</div>

<style>
  .book { width: 100%; max-width: 560px; }
  .bar {
    display: flex; align-items: center; gap: 6px; padding: 6px; padding-inline-start: 18px;
    background: var(--surface); border: 1px solid var(--line-2); border-radius: 18px;
    
    transition: border-color .2s, box-shadow .2s;
  }
  .bar:focus-within { border-color: var(--ink-2); }
  .mail { color: var(--ink-3); font-size: 1.1rem; }
  input[type="email"] {
    flex: 1; min-width: 0; height: 52px; border: 0; background: transparent; outline: none;
    font: 400 1.05rem/1 var(--f-body); color: var(--ink);
  }
  input::placeholder { color: var(--ink-3); }
  button {
    display: inline-flex; align-items: center; gap: 10px; height: 52px; padding-inline: 22px 18px; border: 0; border-radius: 13px; cursor: pointer;
    font: 700 1.02rem/1 var(--f-body); white-space: nowrap; background: var(--accent); color: var(--accent-ink);
    transition: transform .15s, filter .15s;
  }
  button:hover { filter: brightness(1.08); }
  button:active { transform: translateY(1px); }
  button:disabled { filter: saturate(.4); cursor: progress; }
  .md .bar { border-radius: 16px; }
  .assure { display: flex; flex-wrap: wrap; gap: 6px 18px; margin-top: 14px; font-size: .88rem; color: var(--ink-3); }
  .assure li { display: inline-flex; align-items: center; gap: 6px; }
  .assure .ico { color: var(--ink-3); font-size: .95rem; }
  .msg { font-size: .92rem; margin-top: 12px; }
  .msg:empty { display: none; }
  .msg.err { color: var(--danger); }
  .done {
    display: flex; gap: 16px; align-items: flex-start; padding: 20px 22px; border-radius: 18px;
    background: var(--surface); border: 1px solid var(--line-2);
  }
  .tick { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; background: var(--surface-2); color: var(--ink); flex: none; }
  .d1 { font: 800 1.15rem/1.5 var(--f-display); }
  .d2 { color: var(--ink-2); font-size: .95rem; margin-top: 4px; }
  .d2 a { color: var(--ink); }
  .book:has(.done:not([hidden])) .assure { display: none; }

  @media (max-width: 460px) {
    .bar { flex-wrap: wrap; padding: 8px; }
    .mail { display: none; }
    input[type="email"] { flex-basis: 100%; padding-inline: 10px; }
    button { flex: 1; justify-content: center; }
  }
</style>

<script>
  const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  const params = new URLSearchParams(location.search);
  const utm = {
    source: params.get("utm_source") ?? "",
    medium: params.get("utm_medium") ?? "",
    campaign: params.get("utm_campaign") ?? "",
  };

  for (const box of document.querySelectorAll<HTMLElement>("[data-book]")) {
    const form = box.querySelector("form")!;
    const input = form.querySelector<HTMLInputElement>('input[type="email"]')!;
    const button = form.querySelector("button")!;
    const label = button.querySelector<HTMLElement>(".lbl")!;
    const msg = box.querySelector<HTMLElement>(".msg")!;
    const done = box.querySelector<HTMLElement>(".done")!;
    const fail = (text: string) => { msg.className = "msg err"; msg.textContent = text; };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const email = String(data.get("email") ?? "").trim();
      if (!emailRe.test(email)) { fail("اكتب إيميل صحيح، زي name@example.com"); input.focus(); return; }
      button.disabled = true; label.textContent = "بنحجزلك…"; msg.className = "msg"; msg.textContent = "";
      try {
        const res = await fetch("/api/waitlist", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email, website: String(data.get("website") ?? ""), utm, referrer: document.referrer.slice(0, 300) }),
        });
        if (res.ok) { form.hidden = true; done.hidden = false; return; }
        const body = await res.json().catch(() => ({}));
        fail(body.error === "invalid_email" ? "اكتب إيميل صحيح، زي name@example.com" : "الحجز ما تمّش. جرّب تاني بعد دقيقة.");
      } catch {
        fail("مفيش اتصال. اتأكد من النت وجرّب تاني.");
      } finally {
        button.disabled = false; label.textContent = "احجز مكاني";
      }
    });
  }
</script>
